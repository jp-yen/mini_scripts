{
  "manifest_version": 3,
  "name": "Selection Clean Copy (行番号削除コピー)",
  "version": "1.1.0",
  "description": "Copilotやターミナル出力から行番号・プロンプトを除去し、Ctrl+C禁止環境でも確実にコピーできるChrome拡張機能",
  "permissions": [
    "tabs",
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Selection Clean Copy 設定",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "copy-clean-selection": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "選択テキストから行番号を除去してクリーンコピー"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}