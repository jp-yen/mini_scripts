<UserControl x:Class="FontSelector.Views.Controls.PreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FontSelector.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- プレビューテキスト入力欄専用スタイル (左上開始・コンパクトパディング) -->
        <Style x:Key="PreviewInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Border Background="{DynamicResource PanelBackground}"
            CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" Padding="8,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Row 0: Quick action bar -->
                <RowDefinition Height="3*" MinHeight="100" />     <!-- Row 1: Preview text (WebView2) -->
                <RowDefinition Height="Auto" />  <!-- Row 2: Movable GridSplitter -->
                <RowDefinition Height="2*" MinHeight="160" />  <!-- Row 3: Lower panel (Font adjustment + Custom text input) -->
            </Grid.RowDefinitions>

            <!-- Quick copy bar above preview -->
            <Border Grid.Row="0" Margin="0,0,0,4" Padding="0,0,0,4"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedFamily.FamilyName, FallbackValue='フォントを選択してください'}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="300" />

                        <ComboBox ItemsSource="{Binding SelectedFamily.Typefaces}"
                                  SelectedItem="{Binding SelectedTypeface}"
                                  Style="{DynamicResource FilterComboBox}"
                                  MinWidth="110" Height="26"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  ToolTip="フォントファミリー内の書体（ウェイト・スタイル）を切り替えます">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="IsEnabled" Value="{Binding IsFilterMatched}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.38" />
                                            <Setter Property="ToolTip" Value="現在のフィルター条件（言語・文字セット等）に非対応の書体です" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StyleName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{DynamicResource MiniButton}"
                                Content="📋 フォント名をコピー"
                                Command="{Binding CopyFontNameCommand}"
                                ToolTip="フォント名（スタイル含む）をクリップボードにコピー"
                                Margin="0,0,8,0" />
                        <Button Style="{DynamicResource MiniButton}"
                                Content="📋 CSS をコピー"
                                Command="{Binding CopyCssCommand}"
                                ToolTip="CSS の font-family 指定をクリップボードにコピー" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preview text (WebView2 for full color emoji and modern typography) -->
            <Border Grid.Row="1" Background="Transparent" CornerRadius="4" ClipToBounds="True"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <wv2:WebView2 x:Name="PreviewWebView"
                              DefaultBackgroundColor="Transparent" />
            </Border>

            <!-- 上下に動かせる仕切り (GridSplitter) -->
            <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" ResizeDirection="Rows"
                          Background="Transparent" Cursor="SizeNS" ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Padding="0,2">
                            <Grid>
                                <!-- 区切り線 -->
                                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}"
                                           VerticalAlignment="Center" />
                                <!-- ドラッグ用の中央グリップ -->
                                <Border x:Name="GripHandle" Width="36" Height="3" CornerRadius="1.5"
                                        Background="{DynamicResource BorderBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GripHandle" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="GripHandle" Property="Width" Value="48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 下部エリア: フォント調整（高さ固定） + プレビューテキスト入力欄（伸縮可能） -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- フォント調整パネル（内容サイズ固定） -->
                    <RowDefinition Height="*" MinHeight="65" />     <!-- プレビューテキスト入力欄（ドラッグ連動で伸縮） -->
                </Grid.RowDefinitions>

                <!-- プレビュー微調整パネル（サイズ・太さ・文字幅・傾き） -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="6"
                        Padding="8,4" Margin="0,1,0,4">
                    <StackPanel Orientation="Vertical">
                        <!-- ヘッダー行: タイトル + バリアブルバッジ + 可変軸サマリー + イタリック + リセットボタン -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="フォント調整" Foreground="{DynamicResource PrimaryText}"
                                           FontWeight="Bold" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Border Visibility="{Binding Preview.IsSelectedFontVariable, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="バリアブル対応" Foreground="White" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{Binding Preview.VariableAxesSummary}" Foreground="{DynamicResource MutedText}"
                                           FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="イタリック体 (ital)" IsChecked="{Binding Preview.IsItalic}"
                                          Foreground="{DynamicResource PrimaryText}" FontSize="11"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Style="{DynamicResource MiniButton}" Content="🔄 リセット"
                                        Command="{Binding Preview.ResetAdjustmentsCommand}" ToolTip="標準の太さ・サイズに戻す"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- スライダー群（2行2列構成） -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <!-- 1列目 -->
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <!-- 2列目 -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- [1行目-左] サイズ -->
                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="サイズ" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                                <Slider Grid.Column="1" Style="{DynamicResource PreviewSlider}" Minimum="10" Maximum="72" Value="{Binding Preview.FontSize}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Preview.FontSize, StringFormat='{}{0:0} pt'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <!-- [1行目-右] 太さ (wght) -->
                            <Grid Grid.Row="0" Grid.Column="2" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="太さ" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                                <Slider Grid.Column="1" Style="{DynamicResource PreviewSlider}" Minimum="{Binding Preview.WeightMin}" Maximum="{Binding Preview.WeightMax}" Value="{Binding Preview.WeightValue}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Preview.WeightValue, StringFormat='{}{0:0}'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <!-- [2行目-左] 文字幅 (wdth) -->
                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="文字幅" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                                <Slider Grid.Column="1" Style="{DynamicResource PreviewSlider}" Minimum="{Binding Preview.WidthMin}" Maximum="{Binding Preview.WidthMax}" Value="{Binding Preview.WidthScale}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Preview.WidthScale, StringFormat='{}{0:0} %'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <!-- [2行目-右] 傾き (slnt: バリアブルフォント対応時のみ有効) -->
                            <Grid Grid.Row="1" Grid.Column="2" Margin="0,1"
                                  IsEnabled="{Binding Preview.HasSlantAxis}"
                                  Opacity="{Binding Preview.HasSlantAxis, Converter={x:Null}}"
                                  ToolTip="{Binding Preview.HasSlantAxis, Converter={x:Null}}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Setter Property="ToolTip" Value="選択中のフォントは傾き可変軸 (slnt) に対応していません" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="True">
                                                <Setter Property="Opacity" Value="1.0" />
                                                <Setter Property="ToolTip" Value="傾き (slnt 軸) を調整します" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="傾き" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                                <Slider Grid.Column="1" Style="{DynamicResource PreviewSlider}"
                                        Minimum="{Binding Preview.SlantMin}"
                                        Maximum="{Binding Preview.SlantMax}"
                                        Value="{Binding Preview.SlantAngle}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Preview.SlantAngle, StringFormat='{}{0:0} °'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Custom text input: プレビューテキスト入力エリア -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x270F;" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="プレビューテキスト" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{DynamicResource MiniButton}"
                                    Content="😀 絵文字の文例"
                                    Command="{Binding Preview.ApplyEmojiSampleTextCommand}"
                                    ToolTip="Unicode 1.1〜17.0までのバージョン別絵文字・スキントーン・最新文字の文例を表示します"
                                    Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Button Style="{DynamicResource MiniButton}"
                                    Content="⚡ Nerd Fonts の文例"
                                    Command="{Binding Preview.ApplyNerdFontsSampleTextCommand}"
                                    ToolTip="Powerline記号、Git、プログラミング言語、OS・ツールアイコン等の Nerd Fonts (Nord) の文例を表示します"
                                    Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Button Content="🌐 現在の言語の文例"
                                    Command="{Binding Preview.ApplyLanguageSampleTextCommand}"
                                    ToolTip="プルダウンで選択された言語（またはフォントの対応言語）の文例・ASCII・数字をプレビューにセットします"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Preview.IsSampleTextMismatched}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                    
                    <TextBox Grid.Row="1" Style="{StaticResource PreviewInputTextBoxStyle}"
                             Text="{Binding Preview.PreviewText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Segoe UI Emoji, Noto Color Emoji, Meiryo, sans-serif"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45"
                             VerticalScrollBarVisibility="Auto" FontSize="16" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
