<UserControl x:Class="FontSelector.Views.Controls.LoadingOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FontSelector.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    
    <Border Background="{DynamicResource WindowBackground}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
            Panel.ZIndex="1000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="40,32"
                    Width="440">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <!-- Logo / Icon -->
                    <Border Width="64" Height="64" CornerRadius="14" Margin="0,0,0,16"
                            HorizontalAlignment="Center" ClipToBounds="True">
                        <Image Source="/app.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="フォントを読み込み中..."
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />

                    <!-- Progress Bar -->
                    <ProgressBar Style="{DynamicResource ThemedProgressBar}"
                                 Value="{Binding LoadingProgressPercent}"
                                 Maximum="100"
                                 Width="360"
                                 Margin="0,0,0,14" />

                    <!-- 2段表示 (フォント一覧 / 詳細) -->
                    <Border Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Width="360">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1段目: リスト作成 -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="リスト作成"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding LoadingListStatus}"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <!-- 2段目: フォント解析 -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="フォント解析"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding LoadingDetailStatus}"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
