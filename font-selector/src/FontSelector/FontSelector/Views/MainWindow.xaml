<Window x:Class="FontSelector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FontSelector.Views.Controls"
        Title="Font Selector"
        Width="1280" Height="850"
        MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        ToolTipService.InitialShowDelay="150"
        ToolTipService.BetweenShowDelay="0"
        Icon="/app.ico"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Search Bar -->
            <RowDefinition Height="Auto" />  <!-- Filter Bar -->
            <RowDefinition Height="*" />     <!-- Main Content -->
            <RowDefinition Height="Auto" />  <!-- Info Panel -->
            <RowDefinition Height="Auto" />  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <controls:SearchBarControl Grid.Row="0" />
        <controls:FilterBarControl Grid.Row="1" />

        <Grid Grid.Row="2" Margin="12,2,12,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="250" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="3*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <controls:FontListControl Grid.Column="0" />

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent" />

            <controls:PreviewControl Grid.Column="2" />
        </Grid>

        <controls:FontInfoPanelControl Grid.Row="3" />

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{DynamicResource PanelBackground}" Padding="12,4">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryText}" FontSize="11" />
        </Border>

        <!-- Loading Overlay (Spans all rows) -->
        <controls:LoadingOverlayControl Grid.Row="0" Grid.RowSpan="5" />
    </Grid>
</Window>
