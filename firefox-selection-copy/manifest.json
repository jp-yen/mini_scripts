{
  "manifest_version": 3,
  "name": "Selection Clean Copy",
  "version": "1.1.1",
  "description": "Ctrl+C禁止環境でもコピーしたい人のためのFirefox拡張機能。行番号を除去し、コード本文を改変せず確実にコピーします。",
  "browser_specific_settings": {
    "gecko": {
      "id": "selection-clean-copy@firefox.addon",
      "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/jp-yen/mini_scripts/main/firefox-selection-copy/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Selection Clean Copy 設定",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "copy-clean-selection": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "選択テキストから行番号を除去してクリーンコピー"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}