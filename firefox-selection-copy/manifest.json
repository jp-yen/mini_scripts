{
  "manifest_version": 3,
  "name": "Selection Clean Copy (行番号削除コピー)",
  "version": "1.0.0",
  "description": "Copilotやターミナル出力から行番号・プロンプトを除去し、Ctrl+C禁止環境でも確実にコピーできるFirefox拡張機能",
  "browser_specific_settings": {
    "gecko": {
      "id": "selection-clean-copy@firefox.addon",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Selection Clean Copy 設定",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "copy-clean-selection": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "選択テキストから行番号を除去してクリーンコピー"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
